# 도로명주소 API (juso.go.kr) - 주소 자동완성
JUSO_API_KEY=your_key

# 공공데이터포털 API (data.go.kr) - 토지/주택 공시가격
DATA_GO_KR_API_KEY=your_key

# Flask
SECRET_KEY=your_secret_key
FLASK_DEBUG=true
PORT=5000

# PostgreSQL (Neon) - 회원 인증용
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Owner 계정 (flask seed-owner로 생성)
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=your_secure_password
